# ---------------------------------------------------------------------------
# Steeped Dives - local configuration
#
# Copy to .env and fill in. .env is gitignored; this file is the committed
# contract, so every variable the code reads has to appear here.
#
#   cp .env.example .env
#
# Everything is machine-local: the warehouses are a local Postgres instance
# and two local Spark/Derby metastores. Nothing points at a cloud account, and
# no raw data is committed.
# ---------------------------------------------------------------------------

# --- Postgres (board_games dbt project) ------------------------------------
# Standard libpq variable names, so psql, psycopg2 and dbt all read the same
# five values and `psycopg2.connect()` picks them up with no arguments.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change-me
PGDATABASE=postgres

# dbt looks here for profiles.yml before falling back to ~/.dbt. Each project
# ships its own, so point this at whichever project you are running.
# DBT_PROFILES_DIR=./board_games/dbt

# --- Local data root -------------------------------------------------------
# Raw downloads, Parquet, Spark warehouses and Derby metastores all live
# outside the repo. Absolute paths: Spark resolves them before any chdir.
STEEPED_DATA_DIR=/absolute/path/to/Data

# --- flights_medallion (BTS on-time performance) ---------------------------
FLIGHTS_DATA_DIR=${STEEPED_DATA_DIR}/FlightsETL
FLIGHTS_ZIP_DIR=${STEEPED_DATA_DIR}/FlightsETL/zipped_csvs
FLIGHTS_PARQUET_DIR=${STEEPED_DATA_DIR}/FlightsETL/parquet

# --- natality_names_kimball (SSA names + CDC natality + name origins) ------
NATALITY_DATA_DIR=${STEEPED_DATA_DIR}/NationalNames
NATALITY_NAMES_DIR=${STEEPED_DATA_DIR}/NationalNames
NATALITY_NATALITY_DIR=${STEEPED_DATA_DIR}/NationalNames/natality
NATALITY_ORIGINS_DIR=${STEEPED_DATA_DIR}/NationalNames/origins

# --- Spark / JVM -----------------------------------------------------------
# dbt-spark's session method runs Spark inside dbt's own process and will not
# set JAVA_HOME for you, so it has to be exported before `dbt run`.
JAVA_HOME=/opt/homebrew/opt/openjdk@17

# local[*] for the 17M-row flights pipeline, local[4] is plenty for natality.
SPARK_MASTER=local[*]
SPARK_SHUFFLE_PARTITIONS=64
SPARK_DRIVER_MEMORY=8g
SPARK_EXECUTOR_MEMORY=8g

# Natality runs smaller and single-threaded against one Derby metastore.
NATALITY_SPARK_MASTER=local[4]
NATALITY_SPARK_SHUFFLE_PARTITIONS=8

# Which point in time snapshot for all datasets. 
BOARD_GAMES_SCRAPE_DATE=2026-09-23
FLIGHTS_EXTRACT_DATE=2026-10-05
NATALITY_EXTRACT_DATE=2026-10-02